# ReviewAid v3.0.0 validation — local secrets. NEVER commit or share this file.

# Google Gemini — free-tier cloud backend. Create a key (no credit card) at
# https://aistudio.google.com/apikey — ~15 requests/min, ~1,500 requests/day.
# Do NOT enable billing on the project (it can void the free tier).

GEMINI_API_KEY=

# Cohere backends — trial keys give ~1000 calls EACH. keys.py rotates automatically.
# Scope: screening 2000 + EvidenceInference extraction 2184  ->  ~4700 calls with overhead
#       -> 5 keys minimum, 6 recommended. 
# To add keys: append to the same comma-separated line, then run: python keys.py

COHERE_KEYS=

# Ollama (local backend)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# emails (required by NCBI Entrez and Unpaywall)
ENTREZ_EMAIL=your_mail@mail.com
UNPAYWALL_EMAIL=your_mail@mail.com

# Optional PDF-fetch boosters for the CSMeD screening corpus
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=


